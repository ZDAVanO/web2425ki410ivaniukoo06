<%- include("partials/header.ejs") %>

  <h1>Home Page</h1>

  <p>Page loaded at: <span id="load-time"></span></p>

  <div class="container mt-5 pt-3 pb-3 border rounded col-12 col-md-8 col-lg-6">
    <h2>AJAX GET Request</h2>
    <button id="ajax-get-btn" class="btn btn-primary">Send GET Request</button>
    <p id="ajax-get-response"></p>
    <p id="ajax-get-timestamp"></p>
  </div>

  <div class="container mt-5 pt-3 pb-3 border rounded col-12 col-md-8 col-lg-6">
    <h2>AJAX POST Request</h2>
    <form id="ajax-post-form" class="">
      <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Email address</label>
        <input type="email" class="form-control" id="exampleInputEmail1" name="email" aria-describedby="emailHelp" required>
        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
      </div>
      <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Password</label>
        <input type="password" class="form-control" id="exampleInputPassword1" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary">Send POST Request</button>
    </form>
    <p id="ajax-post-response"></p>
    <p id="ajax-post-timestamp"></p>
  </div>

  <script src="ajax.js"></script>

<%- include("partials/footer.ejs") %>